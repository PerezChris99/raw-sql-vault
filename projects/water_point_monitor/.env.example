# ============================================================================
# Water Point Usage Monitor - Environment Configuration
# PostgreSQL 14+ with TimescaleDB 2.x
# ============================================================================

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=water_point_monitor
DB_USER=postgres
DB_PASSWORD=your_password_here

# TimescaleDB Configuration
# These are set via SQL during setup
TIMESCALEDB_TELEMETRY=off

# Hypertable Settings (reference - set in migrations)
# CHUNK_TIME_INTERVAL=1 day (usage_logs)
# CHUNK_TIME_INTERVAL=7 days (health_score_history)

# Compression Settings (reference - set in migrations)
# COMPRESSION_AFTER=7 days
# COMPRESSION_SEGMENTBY=borehole_id
# COMPRESSION_ORDERBY=recorded_at DESC

# Retention Policy (reference - set in migrations)
# RETENTION_PERIOD=365 days (usage_logs)
# RETENTION_PERIOD=730 days (health_score_history)

# Alert Thresholds
RISK_THRESHOLD_WARNING=40
RISK_THRESHOLD_CRITICAL=60
RISK_THRESHOLD_EMERGENCY=80

USAGE_DROP_THRESHOLD=30
FLOW_DEGRADATION_THRESHOLD=70
PUMP_CYCLING_THRESHOLD=10

# Report Settings
REPORT_OUTPUT_DIR=./output
REPORT_FORMAT=text

# Monitoring
HEALTH_CHECK_INTERVAL=3600
ALERT_CHECK_INTERVAL=300
