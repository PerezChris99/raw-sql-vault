# Corruption Report Auditor - Environment Configuration
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=corruption_auditor
DB_USER=postgres
DB_PASSWORD=your_password_here

# Application Settings
LOG_LEVEL=INFO
OUTPUT_PATH=./output

# Report Settings
DEFAULT_REPORT_FORMAT=console
REPORT_RETENTION_DAYS=90

# Email Notifications (Optional)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=reports@example.com
SMTP_PASSWORD=smtp_password
ALERT_RECIPIENTS=admin@example.com,supervisor@example.com

# SLA Alert Thresholds
SLA_WARNING_DAYS=3
SLA_CRITICAL_DAYS=0
STALE_CASE_DAYS=14
AGING_ALERT_DAYS=180
