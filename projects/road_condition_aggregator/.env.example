# =============================================================================
# Road Condition Aggregator - Environment Configuration
# =============================================================================
# Copy this file to .env and update values for your environment
# =============================================================================

# PostgreSQL Connection Settings
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=road_condition_db

# PostGIS Settings (optional)
POSTGIS_GDAL_ENABLED_DRIVERS=ENABLE_ALL
POSTGIS_ENABLE_OUTDB_RASTERS=1

# DBSCAN Clustering Parameters
# eps: Distance threshold in degrees (~0.0001 = 11m at equator)
# min_points: Minimum reports to form a cluster
DBSCAN_EPS=0.0005
DBSCAN_MIN_POINTS=3
DBSCAN_DAYS_BACK=30

# Priority Scoring Weights (must sum to ~100)
PRIORITY_SEVERITY_WEIGHT=40
PRIORITY_DENSITY_WEIGHT=30
PRIORITY_ROAD_WEIGHT=30

# SLA Configuration (days)
SLA_CRITICAL_DAYS=1
SLA_HIGH_DAYS=3
SLA_MEDIUM_DAYS=7
SLA_LOW_DAYS=14

# Report Settings
REPORT_OUTPUT_DIR=./output
REPORT_DATE_FORMAT=yyyy-MM-dd HH:mm:ss

# Development Settings
DEBUG=false
LOG_LEVEL=INFO
