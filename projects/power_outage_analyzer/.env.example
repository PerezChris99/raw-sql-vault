# Power Outage Pattern Analyzer - Environment Configuration
# Copy this file to .env and configure for your environment

# PostgreSQL/PostGIS Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=power_outage_db
PGUSER=postgres
PGPASSWORD=your_secure_password

# PostGIS specific
POSTGIS_VERSION=3.4

# Application settings
DEFAULT_SRID=4326
CLUSTER_COUNT=5
HOTSPOT_GRID_SIZE_M=1000
PROXIMITY_RADIUS_M=500

# Report output
REPORT_OUTPUT_DIR=./output
REPORT_FORMAT=console

# Logging
LOG_LEVEL=INFO
